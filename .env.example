# Copy to .env (gitignored). On the admin server these go in /etc/admin/admin-api.env instead.

# The app backend's read-only Admin API. Only answers from the AWS admin server (3.110.2.48) and the Azure VM.
ADMIN_API_BASE_URL=https://api.15-252-244-218.sslip.io/admin/v1
# On the admin server: aws ssm get-parameter --region ap-south-1 --name /risips/admin/admin-api-key --with-decryption
ADMIN_API_KEY=

# Where this API listens. The dashboard calls it on the same machine: ADMIN_API_URL=http://127.0.0.1:3005
PORT=3005
HOST=127.0.0.1
# PostgreSQL (Neon). The pooled (-pooler) endpoint is fine. Use sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Tables live in this schema, created on first start.
DB_SCHEMA=admin
# DB_POOL_MAX=5
NODE_ENV=production

# Authenticator-app step at sign-in. Turn on once every staff member is ready to enrol.
STAFF_MFA_ENABLED=false

# HUF onboarding on NSE Invest. Encrypts each HUF's PANs, bank account and dates of birth in the database.
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in Parameter Store: lose it and saved HUFs can't be read or re-sent.
ADMIN_DATA_KEY=
# UAT by default. This machine's IP must be whitelisted by NSE. The keys differ by one character (…94BD… / …94BE…).
NSE_BASE_URL=https://nseinvestuat.nseindia.com
NSE_MEMBER_CODE=
NSE_LOGIN_USER_ID=ADMIN
NSE_API_KEY_MEMBER=
NSE_API_SECRET_USER=
# The live account (https://www.nseinvest.com) is refused unless this is true. Needs Akash's OK.
# NSE_ALLOW_PROD=false
# FATCA UBO_CODE for the karta (not in NSE's doc; C01 is its sample value). Change if KFin rejects it.
# NSE_HUF_UBO_CODE=C01
# The distributor employee's EUIN on HUF orders and SIPs (the live orders use E696775); blank sends declaration N.
# NSE_EUIN=
# NSE_SUB_BROKER_ARN=
# A second staff member must approve each HUF. Only turn off on a one-person test setup.
# HUF_SECOND_APPROVER=true

# Optional
# Dashboard server(s) whose X-Forwarded-For is believed. On the Azure VM: TRUST_PROXY=loopback,3.110.2.48
# TRUST_PROXY=loopback
# Shared with the dashboard (its ADMIN_API_PROXY_KEY): it vouches for the visitor IP it passes on. Needed for HUF
# consent in production, because Caddy hides that IP. 32+ random characters, the same value on both sides.
# DASHBOARD_PROXY_KEY=
# STAFF_SESSION_HOURS=12
# STAFF_SESSION_IDLE_MINUTES=60
# COMPLIANCE_SCAN_INTERVAL_MS=1800000
# VALUATION_INTERVAL_MS=900000
# LARGE_TRANSACTION_AMOUNT=500000

# Laptop development only: reach the Admin API through the Azure VM. First open the tunnel:
#   ssh -i ~/.ssh/vps_key -f -N -L 18888:127.0.0.1:8888 azureuser@74.225.175.227
# HTTPS_PROXY=http://127.0.0.1:18888
